--
-- Name: academic_blackouts; Type: ROW SECURITY; Schema: public; Owner: postgres
--

ALTER TABLE public.academic_blackouts ENABLE ROW LEVEL SECURITY;

--
-- Name: academic_blackouts academic_blackouts_select; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY academic_blackouts_select ON public.academic_blackouts FOR SELECT TO authenticated USING ((college_id = public.current_user_college_id()));


--
-- Name: academic_blackouts academic_blackouts_update; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY academic_blackouts_update ON public.academic_blackouts FOR UPDATE TO authenticated USING ((college_id = public.current_user_college_id())) WITH CHECK ((college_id = public.current_user_college_id()));


--
-- Name: applications; Type: ROW SECURITY; Schema: public; Owner: postgres
--

ALTER TABLE public.applications ENABLE ROW LEVEL SECURITY;

--
-- Name: applications applications_select; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY applications_select ON public.applications FOR SELECT TO authenticated USING ((EXISTS ( SELECT 1
   FROM public.student_profiles sp
  WHERE ((sp.user_id = applications.student_id) AND (sp.college_id = public.current_user_college_id())))));


--
-- Name: applications applications_update; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY applications_update ON public.applications FOR UPDATE TO authenticated USING ((EXISTS ( SELECT 1
   FROM public.student_profiles sp
  WHERE ((sp.user_id = applications.student_id) AND (sp.college_id = public.current_user_college_id())))));


--
-- Name: audit_logs; Type: ROW SECURITY; Schema: public; Owner: postgres
--

ALTER TABLE public.audit_logs ENABLE ROW LEVEL SECURITY;

--
-- Name: audit_logs audit_logs_select_own; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY audit_logs_select_own ON public.audit_logs FOR SELECT TO authenticated USING ((user_id = auth.uid()));


--
-- Name: college_admin_profiles; Type: ROW SECURITY; Schema: public; Owner: postgres
--

ALTER TABLE public.college_admin_profiles ENABLE ROW LEVEL SECURITY;

--
-- Name: college_admin_profiles college_admin_profiles_same_college_select; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY college_admin_profiles_same_college_select ON public.college_admin_profiles FOR SELECT TO authenticated USING ((college_id = ( SELECT users.college_id
   FROM public.users
  WHERE (users.id = auth.uid()))));


--
-- Name: college_admin_profiles college_admin_profiles_same_college_update; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY college_admin_profiles_same_college_update ON public.college_admin_profiles FOR UPDATE TO authenticated USING ((college_id = ( SELECT users.college_id
   FROM public.users
  WHERE (users.id = auth.uid())))) WITH CHECK ((college_id = ( SELECT users.college_id
   FROM public.users
  WHERE (users.id = auth.uid()))));


--
-- Name: college_admin_profiles college_admin_profiles_select; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY college_admin_profiles_select ON public.college_admin_profiles FOR SELECT TO authenticated USING (((college_id = ( SELECT users.college_id
   FROM public.users
  WHERE (users.id = auth.uid()))) AND (EXISTS ( SELECT 1
   FROM public.users
  WHERE ((users.id = auth.uid()) AND ((users.role)::text = 'college_admin'::text))))));


--
-- Name: college_admin_profiles college_admin_profiles_update; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY college_admin_profiles_update ON public.college_admin_profiles FOR UPDATE TO authenticated USING (((college_id = ( SELECT users.college_id
   FROM public.users
  WHERE (users.id = auth.uid()))) AND (EXISTS ( SELECT 1
   FROM public.users
  WHERE ((users.id = auth.uid()) AND ((users.role)::text = 'college_admin'::text)))))) WITH CHECK (((college_id = ( SELECT users.college_id
   FROM public.users
  WHERE (users.id = auth.uid()))) AND (EXISTS ( SELECT 1
   FROM public.users
  WHERE ((users.id = auth.uid()) AND ((users.role)::text = 'college_admin'::text))))));


