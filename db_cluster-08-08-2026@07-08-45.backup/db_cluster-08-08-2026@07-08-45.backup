--
-- Name: document_access_logs; Type: ROW SECURITY; Schema: public; Owner: postgres
--

ALTER TABLE public.document_access_logs ENABLE ROW LEVEL SECURITY;

--
-- Name: document_access_logs document_access_logs_select; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY document_access_logs_select ON public.document_access_logs FOR SELECT TO authenticated USING ((EXISTS ( SELECT 1
   FROM (public.documents d
     JOIN public.users u ON ((u.id = d.user_id)))
  WHERE ((d.id = document_access_logs.document_id) AND (u.college_id = public.current_user_college_id())))));


--
-- Name: document_access_logs document_access_logs_update; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY document_access_logs_update ON public.document_access_logs FOR UPDATE TO authenticated USING ((EXISTS ( SELECT 1
   FROM (public.documents d
     JOIN public.users u ON ((u.id = d.user_id)))
  WHERE ((d.id = document_access_logs.document_id) AND (u.college_id = public.current_user_college_id())))));


